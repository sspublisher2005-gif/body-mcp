# Body-MCP environment example — copy to .env and adjust.
# Everything is LOCAL. No API keys are required or used.

# Whisper model size for ears_listen (downloaded once from Hugging Face).
# Options: tiny.en, base.en, small.en (default), distil-large-v3, large-v3
BODY_MCP_WHISPER_MODEL=small.en

# Browser mode: "headed" (visible, default) or "headless"
BODY_MCP_BROWSER_MODE=headed

# Polite browsing delay range in milliseconds between page actions (human-like).
BODY_MCP_POLITE_DELAY_MS=1500

# v0.2 — execution and concurrency limits
# BODY_MCP_MAX_CONCURRENCY=2
# BODY_MCP_HARD_MAX_CONCURRENCY=4
# BODY_MCP_BATCH_DEADLINE_MS=120000
# BODY_MCP_PARALLEL_DEADLINE_MS=180000
# BODY_MCP_TASK_DEADLINE_MS=60000
# BODY_MCP_BACKOFF_BASE_S=1
# BODY_MCP_BACKOFF_MAX_S=60

# Test/dev isolation for permissions/consent/audit state
# BODY_MCP_CONFIG_DIR=C:\\path\\to\\isolated\\config

# Path to tesseract binary (Windows default after UB-Mannheim install).
# Only needed if auto-detection fails for pytesseract.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
